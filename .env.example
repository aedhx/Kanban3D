# ---------------------------------------------------------------------------
# Obligatoire
# ---------------------------------------------------------------------------

# Connexion Postgres — À RENSEIGNER SEULEMENT EN LOCAL.
#
# Sur Netlify, ne posez rien ici : activez la base dans Project configuration →
# Database et Netlify fournit NETLIFY_DB_URL de lui-même. L'application lit, dans
# cet ordre, DATABASE_URL, NETLIFY_DB_URL puis NETLIFY_DATABASE_URL (ce dernier
# pour les sites configurés à l'époque de l'ancienne extension).
#
# En local : postgresql://postgres@localhost:5432/kanban3d
DATABASE_URL=

# Le code que vous partagez avec votre frère pour entrer dans le tableau.
APP_PIN=

# Chaîne aléatoire servant à signer le cookie de session.
# Générez-la avec : openssl rand -hex 32
APP_SECRET=


# ---------------------------------------------------------------------------
# Thingiverse — facultatif, mais nécessaire en production
# ---------------------------------------------------------------------------
# Cloudflare bloque les pages de modèles Thingiverse lorsqu'elles sont demandées
# depuis l'adresse d'un hébergeur : sur Netlify, une carte Thingiverse arrive donc
# nommée « Thingiverse 5564110 », sans image. Depuis un poste de développement la
# même page se lit très bien — la panne ne se voit qu'en ligne.
#
# Son API officielle, elle, répond : créez une application sur
# https://www.thingiverse.com/apps/create (gratuit, immédiat), relevez l'« App
# Token » et posez-le ici. Sans ce jeton l'application fonctionne, mais les cartes
# Thingiverse restent à renommer à la main.
#
# `npm run test:platforms` vous dira en une ligne si le jeton fonctionne.
THINGIVERSE_TOKEN=


# ---------------------------------------------------------------------------
# Notifications — facultatif, mais c'est ce qui rend le tableau vivant
# ---------------------------------------------------------------------------
# Renseignez UN SEUL des trois blocs ci-dessous. Sans aucun, l'application
# fonctionne normalement mais n'envoie rien.
# Les notifications partent sur un canal commun : vous voyez donc aussi vos
# propres actions, ce qui sert d'accusé de réception.

# --- Option 1 : Telegram (recommandé — notification instantanée sur le mobile)
# 1. Sur Telegram, écrivez à @BotFather, envoyez /newbot, suivez les questions.
#    Il vous renvoie un jeton de la forme 123456789:AAE... → TELEGRAM_BOT_TOKEN
# 2. Créez un groupe avec votre frère, ajoutez-y le bot, envoyez-y un message.
# 3. Ouvrez https://api.telegram.org/bot<VOTRE_JETON>/getUpdates et relevez
#    "chat":{"id":-100123...} → TELEGRAM_CHAT_ID (le signe moins fait partie de l'id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Option 2 : ntfy.sh (aucun compte à créer)
# Choisissez un nom de sujet difficile à devenir — n'importe qui connaissant ce
# nom peut lire vos notifications — puis abonnez-vous-y depuis l'application ntfy.
# Accepte soit un nom de sujet, soit une URL complète pour un serveur ntfy privé.
NTFY_TOPIC=

# --- Option 3 : webhook générique (Slack, Discord, n8n, Zapier…)
# Reçoit un POST JSON { "text": "...", "content": "..." }.
# Pour Discord, ajoutez /slack à la fin de l'URL du webhook.
NOTIFY_WEBHOOK_URL=


# ---------------------------------------------------------------------------
# Prix du filament — facultatif
# ---------------------------------------------------------------------------
# Prix d'un kilo de filament, en euros. Posé, chaque carte affiche le coût estimé
# de son impression (« 52 g · ~1,30 € »), et chaque colonne son total.
#
# Absent, aucun prix n'est affiché : mieux vaut ne rien dire qu'avancer un
# chiffre tiré d'une moyenne inventée. La virgule décimale est acceptée.
FILAMENT_PRICE_PER_KG=

# ---------------------------------------------------------------------------
# Obligatoire
# ---------------------------------------------------------------------------

# Connexion Postgres.
# Sur Netlify, l'extension « Netlify DB (Neon) » renseigne cette variable toute seule.
# En local : postgresql://postgres@localhost:5432/kanban3d
DATABASE_URL=

# Le code que vous partagez avec votre frère pour entrer dans le tableau.
APP_PIN=

# Chaîne aléatoire servant à signer le cookie de session.
# Générez-la avec : openssl rand -hex 32
APP_SECRET=


# ---------------------------------------------------------------------------
# Facultatif — brider les essais de connexion
# ---------------------------------------------------------------------------
# Désactivé par défaut. Mettez « on » pour bloquer une adresse après 8 essais
# ratés en 15 minutes. Rien d'autre à faire : la table nécessaire est déjà créée
# par les migrations.
#
# À activer si votre code d'accès est court (quatre ou cinq chiffres) : le site
# étant public, toutes les combinaisons s'épuisent sinon en quelques heures.
# Un code de huit chiffres ou plus rend ce bridage superflu.
AUTH_RATE_LIMIT=


# ---------------------------------------------------------------------------
# Notifications — facultatif, mais c'est ce qui rend le tableau vivant
# ---------------------------------------------------------------------------
# Renseignez UN SEUL des trois blocs ci-dessous. Sans aucun, l'application
# fonctionne normalement mais n'envoie rien.
# Les notifications partent sur un canal commun : vous voyez donc aussi vos
# propres actions, ce qui sert d'accusé de réception.

# --- Option 1 : Telegram (recommandé — notification instantanée sur le mobile)
# 1. Sur Telegram, écrivez à @BotFather, envoyez /newbot, suivez les questions.
#    Il vous renvoie un jeton de la forme 123456789:AAE... → TELEGRAM_BOT_TOKEN
# 2. Créez un groupe avec votre frère, ajoutez-y le bot, envoyez-y un message.
# 3. Ouvrez https://api.telegram.org/bot<VOTRE_JETON>/getUpdates et relevez
#    "chat":{"id":-100123...} → TELEGRAM_CHAT_ID (le signe moins fait partie de l'id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Option 2 : ntfy.sh (aucun compte à créer)
# Choisissez un nom de sujet difficile à devenir — n'importe qui connaissant ce
# nom peut lire vos notifications — puis abonnez-vous-y depuis l'application ntfy.
# Accepte soit un nom de sujet, soit une URL complète pour un serveur ntfy privé.
NTFY_TOPIC=

# --- Option 3 : webhook générique (Slack, Discord, n8n, Zapier…)
# Reçoit un POST JSON { "text": "...", "content": "..." }.
# Pour Discord, ajoutez /slack à la fin de l'URL du webhook.
NOTIFY_WEBHOOK_URL=

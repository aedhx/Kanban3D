# Connexion Postgres.
# Sur Netlify, l'extension « Netlify DB (Neon) » renseigne cette variable toute seule.
# En local : postgresql://postgres@localhost:5432/kanban3d
DATABASE_URL=

# Le code que vous partagez avec votre frère pour entrer dans le tableau.
APP_PIN=

# Chaîne aléatoire servant à signer le cookie de session.
# Générez-la avec : openssl rand -hex 32
APP_SECRET=
